          },
          {
            "name": "date_range",
            "in": "query",
            "required": false,
            "description": "",
            "schema": {
              "type": "string",
              "enum": [
                "1DAY",
                "7DAY",
                "30DAY",
                "90DAY"
              ]
            }
          }
        ],
