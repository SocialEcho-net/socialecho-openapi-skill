    "/v1/tiktokshop/products/sync": {
      "post": {
        "operationId": "syncTiktokShopProducts",
        "summary": "Submit TikTok Shop product sync",
        "description": "LIVE WRITE: changes the selected TikTok Shop account. Show the exact account ID to the user and obtain explicit confirmation immediately before invoking this operation. Do not infer authorization from an earlier or unrelated request.",
        "x-requires-explicit-confirmation": true,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "account_id"
                ],
                "properties": {
                  "account_id": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Success"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
